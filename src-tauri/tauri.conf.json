{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ripper",
  "identifier": "app.ripper.texture",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ripper",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNjVGRjI1MDE1ODM4RDEKUldUUk9GZ0JKZjlsUEJJVERUMXZvT0NtelVQNGtZWU5pb1JJVkUvUitzclplakY0M2V0VHZJNUkK",
      "endpoints": [
        "https://github.com/ozymandi/Grabber/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
